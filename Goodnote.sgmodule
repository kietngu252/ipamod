[Script]
Goodnotes6 = type=http-response,pattern=^https:\/\/isi\..*\.g.*\.com\/.+\/(receipts$|subscribers\/?(.*?)*$),requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/kietngu252/ipamod/refs/heads/main/Goodnote.js

Goodnotes = type=http-request,pattern=^https:\/\/isi\..*\.g.*\.com\/.+\/(receipts$|subscribers\/?(.*?)*$),requires-body=0,max-size=0,script-path=https://raw.githubusercontent.com/kietngu252/ipamod/refs/heads/main/Goodnote.js


[MITM]
hostname = %APPEND% isi.*.g*.com
