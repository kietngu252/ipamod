[Script]

revenuecat = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/kietngu252/ipamod/refs/heads/main/New%20Text%20Document.txt, requires-body=true, max-size=-1, timeout=60

deleteHeader = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/kietngu252/ipamod/refs/heads/main/bd.js, timeout=60

[MITM]
hostname = %APPEND% api.revenuecat.com
